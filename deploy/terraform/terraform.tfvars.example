# cp terraform.tfvars.example terraform.tfvars   (terraform.tfvars is gitignored
# by .gcloudignore; add it to your .gitignore too)

project_id = "my-krishimitra-project"

region          = "asia-south1"
bucket_location = "asia-south1"

# --- Cloud SQL sizing ---------------------------------------------------------
# db-f1-micro       dev only, no SLA
# db-g1-small       small pilot (default)
# db-custom-1-3840  first tier with an SLA
sql_tier              = "db-g1-small"
sql_disk_type         = "PD_HDD"
sql_disk_size_gb      = 10
sql_availability_type = "ZONAL"

# Leave true outside throwaway environments. Set false, apply, THEN destroy —
# two steps on purpose.
sql_deletion_protection = true

# --- Earth Engine -------------------------------------------------------------
# Set true only after registering the project at
# https://console.cloud.google.com/earth-engine and enabling
# earthengine.googleapis.com; otherwise the role grants fail.
enable_earth_engine = false
