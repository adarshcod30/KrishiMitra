# =============================================================================
# KrishiMitra GCP deployment — operator configuration
#
#   cp deploy/env.example deploy/env
#   $EDITOR deploy/env          # fill in PROJECT_ID at minimum
#   ./deploy/00-enable-apis.sh
#
# Every deploy/*.sh script sources deploy/env (override the path with
# DEPLOY_ENV_FILE=/path/to/env). This file holds NO secrets — secret VALUES are
# prompted for interactively by deploy/20-secrets.sh and stored in Secret
# Manager. deploy/env itself is listed in .gcloudignore so it never reaches a
# build; add it to your own .gitignore too if you keep it out of tree.
# =============================================================================

# --- Required ----------------------------------------------------------------

# GCP project that will own every resource. No default: guessing this wrong is
# expensive, so the scripts refuse to run without it.
PROJECT_ID=

# Billing account to link if the project has none. Find it with:
#   gcloud billing accounts list
# Leave empty to skip the check (the scripts will tell you if billing is off).
BILLING_ACCOUNT=

# --- Region / location -------------------------------------------------------

# Cloud Run + Cloud SQL + Artifact Registry region. asia-south1 (Mumbai) is the
# lowest-latency choice for Indian farmers and keeps data in-country.
# Both services must be in the SAME region for the Cloud SQL connector to work
# over the local Unix socket without a VPC connector.
REGION=asia-south1

# Multi-region or region for GCS buckets. "asia-south1" keeps storage co-located
# with compute (cheapest egress); "ASIA" gives multi-region redundancy at a
# higher storage price.
BUCKET_LOCATION=asia-south1

# Cloud Scheduler location. Must be a Scheduler-supported region; usually the
# same as REGION.
SCHEDULER_REGION=asia-south1

# --- Naming ------------------------------------------------------------------

# Artifact Registry Docker repository.
AR_REPO=krishimitra

# Cloud Run service and job names.
API_SERVICE=krishimitra-api
WEB_SERVICE=krishimitra-web
MIGRATE_JOB=krishimitra-migrate
SATELLITE_JOB=krishimitra-satellite
SATELLITE_SCHEDULE_NAME=krishimitra-satellite-weekly

# Cloud SQL.
SQL_INSTANCE=krishimitra-pg
SQL_DB=agrotech
SQL_USER=agrotech

# GCS buckets. Bucket names are GLOBALLY unique, hence the project-id prefix.
# Leave as-is unless you have a naming convention; the scripts substitute
# ${PROJECT_ID} at runtime.
MODELS_BUCKET=${PROJECT_ID}-krishimitra-models
UPLOADS_BUCKET=${PROJECT_ID}-krishimitra-uploads
# Mounted into the satellite Cloud Run Job at /app/outputs, so maps, figures and
# advisory tables are written straight to GCS. It gets its own bucket rather
# than a prefix of the models bucket because Cloud Run's Cloud Storage volumes
# mount a whole bucket, and because imagery products want a different lifecycle
# policy from model weights.
SATELLITE_BUCKET=${PROJECT_ID}-krishimitra-satellite

# Service account IDs (the part before @PROJECT.iam.gserviceaccount.com).
API_SA=krishimitra-api
WEB_SA=krishimitra-web
SATELLITE_SA=krishimitra-satellite
SCHEDULER_SA=krishimitra-scheduler
BUILD_SA=krishimitra-build

# --- Cloud SQL sizing --------------------------------------------------------

# Postgres major version. 17 is the current default for new instances.
SQL_VERSION=POSTGRES_17

# Machine tier. Pilot-scale defaults:
#   db-f1-micro      ~0.6 GB RAM, shared CPU  — cheapest, no SLA, dev only
#   db-g1-small      ~1.7 GB RAM, shared CPU  — sensible small-pilot default
#   db-custom-1-3840 1 vCPU / 3.75 GB         — first tier with an SLA
SQL_TIER=db-g1-small

# HDD is ~4x cheaper than SSD and fine for a low-QPS advisory workload.
# Switch to PD_SSD if you start doing analytical queries over advisories.
SQL_STORAGE_TYPE=PD_HDD
SQL_STORAGE_SIZE_GB=10

# Zonal is single-AZ (cheap). Set to REGIONAL for automatic failover — roughly
# doubles the Cloud SQL bill.
SQL_AVAILABILITY=zonal

# Daily automated backup start time, UTC, HH:MM.
SQL_BACKUP_START_TIME=18:00

# --- Cloud Run sizing --------------------------------------------------------

# The API loads several joblib ensembles into memory (~117 MB for the crop model
# alone) plus numpy/pandas/sklearn/xgboost/lightgbm/catboost. 2Gi is the
# smallest setting that reliably survives a cold start with all four models.
API_CPU=2
API_MEMORY=2Gi
API_MIN_INSTANCES=0
API_MAX_INSTANCES=5
API_CONCURRENCY=20
API_TIMEOUT=300

# The Next.js standalone server is small and mostly I/O bound.
WEB_CPU=1
WEB_MEMORY=512Mi
WEB_MIN_INSTANCES=0
WEB_MAX_INSTANCES=5
WEB_CONCURRENCY=80
WEB_TIMEOUT=60

# Set to 1 to keep one warm API instance. Removes the ~25s model-loading cold
# start (download ~170MB from GCS + unpickle four ensembles), but an idle
# min-instance is billed continuously: at API_CPU=2 / API_MEMORY=2Gi that is
# roughly USD 50-60/month in a Tier-1 region. See the cost table in
# docs/DEPLOY_GCP.md before enabling it.
# API_MIN_INSTANCES=1

# --- Satellite job sizing ----------------------------------------------------

SATELLITE_CPU=2
SATELLITE_MEMORY=4Gi
SATELLITE_TASK_TIMEOUT=3600s
SATELLITE_MAX_RETRIES=1

# Cron for the satellite pipeline. Default: 02:30 IST every Monday — outside
# the Earth Engine peak window and before the working day.
# MUST stay quoted: this file is `source`d by the deploy scripts, and an
# unquoted "30 2 * * 1" would be parsed as an assignment followed by a command,
# with the asterisks glob-expanding against the current directory.
SATELLITE_CRON="30 2 * * 1"
SATELLITE_TIMEZONE=Asia/Kolkata

# Pipeline arguments, comma-separated (passed to Cloud Run Jobs --args).
# "--source,simulate" runs fully offline; "--source,gee" hits Earth Engine.
SATELLITE_ARGS=--source,simulate

# The satellite image is owned by satellite-ml/Dockerfile. EXTRAS controls the
# optional dependency set:
#   gee      earthengine-api + geopandas — real Sentinel-1/2 ingestion (default)
#   gee,geo  adds rasterio for georeferenced GeoTIFF output (~350MB larger)
# NOTE: keep rasterio OUT unless you also switch the job away from the Cloud
# Storage volume mount. GeoTIFF writers seek within the file, and gcsfuse does
# not support random writes; the PNG + .npy fallback is append-only and safe.
SATELLITE_EXTRAS=gee

# --- Earth Engine ------------------------------------------------------------

# Cloud project REGISTERED for Earth Engine. Usually the same as PROJECT_ID —
# individual service accounts can no longer be registered; the project is.
# Register at https://console.cloud.google.com/earth-engine
EE_PROJECT=${PROJECT_ID}

# Set to "true" only if you cannot use Workload Identity and must inject a
# service-account JSON key (see docs/DEPLOY_GCP.md, "Earth Engine on GCP").
# The default of "false" uses Application Default Credentials — no key material
# anywhere, which is strictly more secure.
EE_USE_KEY=false

# --- Application behaviour ---------------------------------------------------

AGROTECH_ENVIRONMENT=production

# Enforce authentication on write endpoints in production.
AGROTECH_REQUIRE_WRITE_AUTH=true

# Admin username for the API's write auth. The password HASH goes into Secret
# Manager via deploy/20-secrets.sh — never the plaintext password, and never
# here.
AGROTECH_ADMIN_USERNAME=admin

# Extra CORS origins beyond the deployed frontend URL, comma-separated. The
# frontend's own Cloud Run URL is appended automatically by 30-deploy.sh.
# Only needed if the browser calls the API cross-origin instead of going
# through the same-origin /api/ml proxy.
EXTRA_CORS_ORIGINS=

# Public URL of the API. Leave empty and 30-deploy.sh fills it in with the real
# Cloud Run URL after the first deploy. Set it explicitly if you have mapped a
# custom domain.
AGROTECH_PUBLIC_BASE_URL=

# Value baked into the frontend's client bundle at BUILD time. "/api/ml" routes
# browser calls through the Next.js server-side proxy on the same origin: no
# CORS, no API hostname in the shipped JavaScript, and the API can stay private.
# Change to an absolute https:// URL only if you want direct browser->API calls.
NEXT_PUBLIC_ML_API_URL=/api/ml

# --- Access control ----------------------------------------------------------

# "true" makes the frontend publicly reachable (allUsers can invoke). This is
# what you want for a farmer-facing app.
WEB_ALLOW_UNAUTHENTICATED=true

# "false" keeps the API PRIVATE: only the frontend's service account may invoke
# it, and browsers reach it exclusively through the /api/ml proxy. This is the
# recommended posture. Set to "true" only if you need direct browser access,
# and then make sure AGROTECH_REQUIRE_WRITE_AUTH=true.
API_ALLOW_UNAUTHENTICATED=false

# --- Local docker-compose parity (not used by the deploy scripts) ------------
# See docker-compose.yml. These mirror the Cloud SQL settings locally.
POSTGRES_USER=agrotech
POSTGRES_PASSWORD=agrotech_local_dev_only
POSTGRES_DB=agrotech
