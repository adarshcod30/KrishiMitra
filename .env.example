# =============================================================================
# KrishiMitra frontend (Next.js) environment
# =============================================================================
# The app has TWO ways to reach the FastAPI ML service. Pick one.
#
# ---------------------------------------------------------------------------
# MODE A (recommended, and the default) — same-origin proxy, no rebuild needed
# ---------------------------------------------------------------------------
# Leave NEXT_PUBLIC_ML_API_URL UNSET. The browser then calls the relative path
# /api/ml/*, which is served by app/api/ml/[...path]/route.ts and forwarded
# server-side to ML_API_URL.
#
# ML_API_URL is a plain (non-public) runtime variable: it is read on each
# request, so a Cloud Run revision can be repointed at a different backend with
# `gcloud run services update --set-env-vars` and NO image rebuild.
#
# Local development (this is also the built-in default if unset):
ML_API_URL=http://127.0.0.1:8000
#
# Cloud Run example:
# ML_API_URL=https://agrotech-api-XXXXXXXX-uc.a.run.app
#
# ---------------------------------------------------------------------------
# MODE B — direct browser -> API calls (requires a public API URL + CORS)
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_* values are inlined into the client bundle at BUILD time, so this
# must be passed as a Docker BUILD ARG, not a runtime env var, and changing it
# requires rebuilding the image. Only use this when the API is publicly
# reachable and its AGROTECH_CORS_ORIGINS allows the frontend origin.
#
# NEXT_PUBLIC_ML_API_URL=https://agrotech-api-XXXXXXXX-uc.a.run.app
#
# NEVER set NEXT_PUBLIC_ML_API_URL to a localhost address for a deployed build:
# it would make every visitor's browser call their own machine.

# Port the Next.js server binds to. Injected automatically by Cloud Run.
# PORT=3000
