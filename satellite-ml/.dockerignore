# Build context hygiene for satellite-ml/Dockerfile.
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.venv/
venv/
.DS_Store

# Generated artefacts — the container writes its own under /app/outputs.
outputs/
data/raw/*
data/interim/*
data/processed/*
!data/**/.gitkeep

# Not needed at runtime.
notebooks/
tests/
dashboard/
Makefile
DATASETS.md
