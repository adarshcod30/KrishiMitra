# =============================================================================
# KrishiMitra ML service (FastAPI) environment
# Copy to .env for local development. NEVER commit the real .env.
# On GCP these come from Secret Manager / Cloud Run env vars — see docs/DEPLOY_GCP.md
# =============================================================================

# Public URL of THIS API. Used to build asset URLs handed to the frontend, so it
# must be the externally reachable address in a real deployment.
AGROTECH_PUBLIC_BASE_URL=http://127.0.0.1:8000

# Comma-separated browser origins allowed to call this API directly (CORS).
# Not needed when the frontend uses the same-origin /api/ml proxy (the default).
# AGROTECH_CORS_ORIGINS=https://agrotech-web-XXXXXXXX-uc.a.run.app

# --- Third-party API keys (all optional; features degrade gracefully) --------
# Multilingual translation (Sarvam AI)
AGROTECH_SARVAM_API_KEY=
AGROTECH_SARVAM_MODEL=mayura:v1

# Web search for the knowledge/news modules (Brave Search)
AGROTECH_BRAVE_SEARCH_API_KEY=

# Government scheme lookup (myscheme.gov.in). Previously hardcoded in source and
# therefore leaked in git history — that key MUST be rotated. When unset, the
# scheme endpoints simply return fewer/no upstream results.
AGROTECH_MYSCHEME_API_KEY=

# --- Persistence ------------------------------------------------------------
# Postgres (Cloud SQL) connection string. When UNSET the service falls back to
# local SQLite under AGROTECH_ARTIFACTS_DIR — fine for dev, NOT for Cloud Run.
# AGROTECH_DATABASE_URL=postgresql://user:password@host:5432/agrotech

# Where model artifacts and (in SQLite mode) the database live.
# AGROTECH_ARTIFACTS_DIR=/app/artifacts
# AGROTECH_UPLOADS_DIR=/app/uploads

# Pull model artifacts from Cloud Storage at startup instead of baking them in.
# AGROTECH_MODELS_GCS_URI=gs://my-project-models/agrotech

# Store user uploads in Cloud Storage instead of container-local disk (required
# on Cloud Run, where the filesystem is ephemeral and per-instance).
# AGROTECH_UPLOADS_GCS_BUCKET=my-project-uploads

# --- Auth (REQUIRED in production) ------------------------------------------
# When true, mutating and PII routes require a bearer token from POST /auth/login.
# Leave false for local development.
AGROTECH_REQUIRE_WRITE_AUTH=false
# AGROTECH_JWT_SECRET=<long-random-string-from-secret-manager>
# AGROTECH_ADMIN_USERNAME=admin
# AGROTECH_ADMIN_PASSWORD_HASH=<bcrypt-hash>

# development | production. In production a JWT secret is mandatory and the
# service refuses to start without one.
AGROTECH_ENVIRONMENT=development
