# =============================================================================
# KrishiMitra ML service (FastAPI) environment
# Copy to .env for local development. NEVER commit the real .env.
#
# EVERYTHING BELOW IS OPTIONAL. With no .env at all the service runs a complete
# local stack: SQLite under AGROTECH_ARTIFACTS_DIR, uploads on local disk, model
# artifacts read from the artifacts directory. Set variables only to move a
# piece of that into a managed service.
#
# Deployed: API on Hugging Face Spaces (Docker), DB on Neon, frontend on Vercel.
# =============================================================================

# --- Runtime ----------------------------------------------------------------
# development | production. In production a JWT secret is mandatory and the
# service refuses to start without one.
AGROTECH_ENVIRONMENT=development

# The HTTP port. Injected by the host, so do NOT hardcode it in a deployment:
# Hugging Face Spaces sets PORT=7860. Default when unset is 8080. The server
# always binds 0.0.0.0.
# PORT=8080

# Public URL of THIS API. Used to build asset URLs handed to the frontend, so it
# must be the externally reachable address in a real deployment
# (e.g. https://<user>-<space>.hf.space).
AGROTECH_PUBLIC_BASE_URL=http://127.0.0.1:8000

# Comma-separated browser origins allowed to call this API directly (CORS).
# Not needed when the frontend uses the same-origin /api/ml proxy (the default).
# AGROTECH_CORS_ORIGINS=https://krishimitra.vercel.app

# --- Database ---------------------------------------------------------------
# Any Postgres URL; Neon is just a Postgres URL and requires TLS, so keep
# ?sslmode=require. Needs the extra: pip install 'agrotech-ml[postgres]'.
# When UNSET the service falls back to local SQLite under AGROTECH_ARTIFACTS_DIR.
# AGROTECH_DATABASE_URL=postgresql://user:password@ep-xxx.aws.neon.tech/agrotech?sslmode=require

# --- Filesystem -------------------------------------------------------------
# Where model artifacts and (in SQLite mode) the database live. Artifacts are
# BAKED INTO THE IMAGE and read from here; nothing is ever downloaded at boot.
# Defaults to <ml-service>/artifacts and <ml-service>/uploads.
# AGROTECH_ARTIFACTS_DIR=/app/artifacts
# AGROTECH_UPLOADS_DIR=/app/uploads

# --- Uploads: OPTIONAL S3-compatible object storage -------------------------
# Works with Cloudflare R2, Supabase Storage, Backblaze B2, MinIO and AWS S3.
# Needs the extra: pip install 'agrotech-ml[s3]'.
# ALL FOUR of ENDPOINT_URL / BUCKET / ACCESS_KEY_ID / SECRET_ACCESS_KEY must be
# set to activate it. If ANY of them is unset, uploads go to local disk exactly
# as they do today. Useful on hosts with an ephemeral filesystem (HF Spaces),
# but not required — the free tier gives 50 GB of ephemeral disk.
# AGROTECH_S3_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com
# AGROTECH_S3_BUCKET=krishimitra-uploads
# AGROTECH_S3_ACCESS_KEY_ID=
# AGROTECH_S3_SECRET_ACCESS_KEY=
# Public/CDN hostname in front of the bucket. When empty, downloads are handed
# out as short-lived presigned URLs instead.
# AGROTECH_S3_PUBLIC_BASE_URL=https://uploads.example.com
# SigV4 needs a region. "auto" (the default) is right for R2/B2/MinIO; set the
# real region only when the endpoint is AWS S3 itself.
# AGROTECH_S3_REGION=auto

# --- Auth (REQUIRED in production) ------------------------------------------
# When true, mutating and PII routes require a bearer token from POST /auth/login.
# Leave false for local development.
AGROTECH_REQUIRE_WRITE_AUTH=false
# AGROTECH_JWT_SECRET=<long-random-string>
# AGROTECH_ADMIN_USERNAME=admin
# AGROTECH_ADMIN_PASSWORD_HASH=<bcrypt-hash>

# --- Third-party API keys (all optional; features degrade gracefully) --------
# Multilingual translation (Sarvam AI)
AGROTECH_SARVAM_API_KEY=
AGROTECH_SARVAM_MODEL=mayura:v1

# Web search for the knowledge/news modules (Brave Search)
AGROTECH_BRAVE_SEARCH_API_KEY=

# Government scheme lookup (myscheme.gov.in). Previously hardcoded in source and
# therefore leaked in git history — that key MUST be rotated. When unset, the
# scheme endpoints simply return fewer/no upstream results.
AGROTECH_MYSCHEME_API_KEY=
