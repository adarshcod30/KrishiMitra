# =============================================================================
# Files NOT uploaded to Cloud Build when running `gcloud builds submit`.
#
# gcloud tars the current directory and uploads it to GCS as the build source,
# so anything excluded here never leaves the machine and never lands in the
# _cloudbuild staging bucket. Mirrors .dockerignore, plus a few things Docker
# needs locally but Cloud Build does not.
#
# NOTE: unlike the default gcloud behaviour, this file does NOT enable
# `#!include:.gitignore` — the exclusions are written out explicitly so that
# gitignored-but-build-required files (none today) cannot silently vanish.
# =============================================================================

.git
.gitignore
.github
.vscode
.idea
**/.DS_Store

# Full second copy of the repo.
.claude

# Reinstalled/rebuilt inside the image.
node_modules
**/node_modules
.next
out
*.tsbuildinfo

# Python caches and virtualenvs (ml-service/agrotech IS a virtualenv).
**/__pycache__
**/*.py[cod]
**/.pytest_cache
**/.ruff_cache
**/.mypy_cache
**/*.egg-info
.venv
**/.venv
venv
**/venv
ml-service/agrotech
ml-service/catboost_info

# Runtime state / large binaries.
ml-service/artifacts
ml-service/uploads
**/*.db
**/*.db-wal
**/*.db-shm
**/*.sqlite
**/*.sqlite3
satellite-ml/outputs
satellite-ml/data/processed
satellite-ml/data/raw
satellite-ml/notebooks
satellite-ml/dashboard

# Secrets must come from Secret Manager, never from the build source.
.env
.env.*
!.env.example
!**/.env.example
*.pem
*.key
*-service-account*.json
*-sa-key*.json
credentials.json
deploy/env
deploy/env.local

# Terraform state can contain secrets in plaintext.
deploy/terraform/.terraform
deploy/terraform/*.tfstate
deploy/terraform/*.tfstate.*
deploy/terraform/*.tfvars
!deploy/terraform/*.tfvars.example
